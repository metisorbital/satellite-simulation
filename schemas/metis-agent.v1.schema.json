            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Negative Min"
        },
        "limit_soc": {
          "title": "Limit Soc",
          "type": "number"
        },
        "margin": {
          "$ref": "#/$defs/MinuteSeries"
        },
        "metis_on": {
          "title": "Metis On",
          "type": "boolean"
        },
        "min_at_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Min At Min"
        },
        "min_wh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Min Wh"
