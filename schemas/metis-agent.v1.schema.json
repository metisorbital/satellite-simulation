              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Downlink Start Soc"
        },
        "downlink_start_wh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Downlink Start Wh"
        },
        "first_negative_min": {
