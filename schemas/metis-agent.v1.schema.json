            {
              "type": "null"
            }
          ]
        },
        "batch": {
          "enum": [
            "pending",
            "running",
            "done",
            "skipped"
          ],
          "title": "Batch",
          "type": "string"
        },
        "batch_start_min": {
          "title": "Batch Start Min",
          "type": "number"
        },
        "capture": {
          "enum": [
            "pending",
            "running",
            "done",
            "skipped"
          ],
          "title": "Capture",
          "type": "string"
        },
        "capture_end_wh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Capture End Wh"
        },
        "committed_min": {
          "title": "Committed Min",
          "type": "number"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "delivered_at_min": {
